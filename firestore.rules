rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is the designated admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'wasoluachristian@gmail.com' ||
        request.auth.uid != null
      );
    }

    // Public read for published content
    match /projects/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /books/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /courses/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings / Site config: readable by all, writable only by admin
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Subscribers: anyone can create (subscribe), only admin can read / list / delete
    match /subscribers/{id} {
      allow create: if request.resource.data.email is string && request.resource.data.email.size() > 3;
      allow read, update, delete: if isAdmin();
    }

    // Contact messages: anyone can create (send message), only admin can read / update / delete
    match /messages/{id} {
      allow create: if request.resource.data.name is string && request.resource.data.email is string && request.resource.data.message is string;
      allow read, update, delete: if isAdmin();
    }

    // Orders / Downloads: visitors can create an order, consume their code (update downloadUsed to true), admin can manage all
    match /orders/{id} {
      allow read: if true;
      allow create: if request.resource.data.customerEmail is string;
      allow update: if (
        isAdmin() ||
        (request.resource.data.downloadUsed == true && resource.data.downloadUsed == false)
      );
      allow delete: if isAdmin();
    }
  }
}
